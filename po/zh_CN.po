#: src/qml/settings/SettingsGeneral.qml
msgctxt "@title"
msgid "General"
msgstr "常规"

msgctxt "@label:listbox"
msgid "Language:"
msgstr "语言："

msgctxt "@title:group"
msgid "Enabled Providers:"
msgstr "已启用的服务商："

msgctxt "@label:checkbox"
msgid "Ollama:"
msgstr "Ollama："

msgctxt "@option:check"
msgid "Enable Ollama provider"
msgstr "启用 Ollama 服务商"

msgctxt "@label:checkbox"
msgid "OpenAI Compatible:"
msgstr "OpenAI 兼容："

msgctxt "@option:check"
msgid "Enable OpenAI Compatible provider"
msgstr "启用 OpenAI 兼容服务商"

msgctxt "@label:checkbox"
msgid "OpenClaw:"
msgstr "OpenClaw："

msgctxt "@option:check"
msgid "Enable OpenClaw provider"
msgstr "启用 OpenClaw 服务商"

msgctxt "@title:group"
msgid "Behavior:"
msgstr "行为："

msgctxt "@label:checkbox"
msgid "Humanized output:"
msgstr "人性化输出："

msgctxt "@option:check"
msgid "Enable humanized output"
msgstr "启用人性化输出"

msgctxt "@info"
msgid ""
"Appends writing guidelines to the Soul system message so responses read more "
"human. Increases token usage."
msgstr "将写作规范追加到 Soul 系统消息中，让回复读起来更像真人。会增加词元用量。"

msgctxt "@title:group"
msgid "MCP (Model Context Protocol):"
msgstr "MCP（模型上下文协议）："

msgctxt "@info"
msgid ""
"MCP allows AI models to use external tools. Configure MCP servers in the MCP "
"Servers settings page."
msgstr "MCP 让 AI 模型能够使用外部工具。请在“MCP 服务器”设置页中配置。"

msgctxt "@info"
msgid "Disabled providers will not appear in the provider dropdown."
msgstr "禁用的服务商不会出现在下拉列表中。"

