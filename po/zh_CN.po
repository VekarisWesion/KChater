#: src/qml/settings/SettingsOpenClaw.qml
msgctxt "@title"
msgid "OpenClaw"
msgstr "OpenClaw"

msgctxt "@info"
msgid "New Instance"
msgstr "新建实例"

msgctxt "@info"
msgid ""
"To use OpenClaw with KChater, you must enable the OpenAI-compatible Chat "
"Completions endpoint in OpenClaw.\n"
"The easiest way to do this is asking OpenClaw to do so."
msgstr ""
"要在 KChater 中使用 OpenClaw，需要先在 OpenClaw 里启用兼容 OpenAI 的 Chat "
"Completions 端点。\n"
"最简单的办法是直接让 OpenClaw 自己去启用。"

msgctxt "@info"
msgid ""
"Configure multiple OpenClaw instances. Add, edit, or remove instances using "
"the buttons below."
msgstr "可配置多个 OpenClaw 实例，用下方按钮添加、编辑或删除。"

msgctxt "@title:group"
msgid "Instances"
msgstr "实例"

msgctxt "@action:button"
msgid "Add Instance"
msgstr "添加实例"

msgctxt "@title:window"
msgid "Edit Instance"
msgstr "编辑实例"

msgctxt "@title:window"
msgid "Add Instance"
msgstr "添加实例"

msgctxt "@label:textbox"
msgid "Display Name:"
msgstr "显示名称："

msgctxt "@info:placeholder"
msgid "e.g., Local OpenClaw, Remote Server"
msgstr "例如：本地 OpenClaw、远程服务器"

msgctxt "@label:textbox"
msgid "URL:"
msgstr "URL："

msgctxt "@label:textbox"
msgid "Token:"
msgstr "令牌："

msgctxt "@info:placeholder"
msgid "Enter your token"
msgstr "输入你的令牌"

msgctxt "@info"
msgid "Connection has not been tested."
msgstr "尚未测试连接。"

msgctxt "@info"
msgid "Testing connection…"
msgstr "正在测试连接…"

msgctxt "@info"
msgid "Connection successful!"
msgstr "连接成功！"

msgctxt "@info"
msgid "Connection timed out after 10 seconds."
msgstr "连接在 10 秒后超时。"

msgctxt "@info"
msgid "Could not reach the server. Check the URL and network connection."
msgstr "无法连接到服务器。请检查 URL 和网络连接。"

msgctxt "@info"
msgid "Authentication failed. Check your API token."
msgstr "身份验证失败。请检查 API 令牌。"

msgctxt "@info"
msgid "Server not found at this URL. Check the API URL."
msgstr "该 URL 上找不到服务器。请检查 API 地址。"

msgctxt "@info"
msgid "Please enter a URL before testing."
msgstr "请先输入 URL 再测试。"

msgctxt "@info"
msgid "Please enter a token before testing."
msgstr "请先输入令牌再测试。"

msgctxt "@info"
msgid "URL must start with http:// or https://."
msgstr "URL 必须以 http:// 或 https:// 开头。"

msgctxt "@info"
msgid "Server returned error %1: %2"
msgstr "服务器返回错误 %1：%2"

msgctxt "@info"
msgid "Unknown connection error."
msgstr "未知的连接错误。"

msgctxt "@action:button"
msgid "Test Now"
msgstr "立即测试"

#: src/qml/settings/SettingsOpenAICompatible.qml
msgctxt "@title"
msgid "OpenAI Compatible"
msgstr "OpenAI 兼容"

msgctxt "@info"
msgid "New Provider"
msgstr "新建服务商"

msgctxt "@info"
msgid ""
"Configure multiple OpenAI-compatible API providers (OpenAI, DeepSeek, Groq, "
"etc.). Add, edit, or remove providers using the buttons below."
msgstr ""
"可配置多个 OpenAI 兼容 API 服务商（OpenAI、DeepSeek、Groq 等），"
"用下方按钮添加、编辑或删除。"

msgctxt "@title:group"
msgid "Providers"
msgstr "服务商"

msgctxt "@action:button"
msgid "Add Provider"
msgstr "添加服务商"

msgctxt "@title:window"
msgid "Edit Provider"
msgstr "编辑服务商"

msgctxt "@title:window"
msgid "Add Provider"
msgstr "添加服务商"

msgctxt "@info:placeholder"
msgid "e.g., DeepSeek, Groq, OpenAI"
msgstr "例如：DeepSeek、Groq、OpenAI"

msgctxt "@label:textbox"
msgid "API URL:"
msgstr "API URL："

msgctxt "@label:textbox"
msgid "API Token:"
msgstr "API 令牌："

msgctxt "@info:placeholder"
msgid "Enter your API token"
msgstr "输入你的 API 令牌"

msgctxt "@label:textbox"
msgid "Model:"
msgstr "模型："

msgctxt "@info"
msgid "Connection successful. %1 model(s) available."
msgstr "连接成功。有 %1 个可用模型。"

msgctxt "@info"
msgid "Please enter an API URL before testing."
msgstr "请先输入 API URL 再测试。"

msgctxt "@info"
msgid "Please enter an API token before testing."
msgstr "请先输入 API 令牌再测试。"

msgctxt "@info"
msgid "Please enter a model name before testing."
msgstr "请先输入模型名称再测试。"

#: src/qml/settings/SettingsMemory.qml
msgctxt "@title"
msgid "Memory"
msgstr "记忆"

msgctxt "@info"
msgid ""
"The AI can save important information here to remember across conversations. "
"You can also edit this manually."
msgstr "AI 可以把重要信息保存在这里，以便在多次对话中记住。你也可以手动编辑。"

msgctxt "@info:placeholder"
msgid ""
"User prefers Portuguese.\n"
"Works with KDE/Qt.\n"
"Likes concise answers."
msgstr ""
"用户偏好葡萄牙语。\n"
"习惯使用 KDE/Qt。\n"
"喜欢简洁的回答。"

