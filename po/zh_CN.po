msgctxt "@action:button"
msgid "Add MCP Server"
msgstr "添加 MCP 服务器"

msgctxt "@title:window"
msgid "Edit MCP Server"
msgstr "编辑 MCP 服务器"

msgctxt "@title:window"
msgid "Add MCP Server"
msgstr "添加 MCP 服务器"

msgctxt "@info:placeholder"
msgid "e.g., Exa Search"
msgstr "例如：Exa Search"

msgctxt "@label:textbox"
msgid "MCP Server URL:"
msgstr "MCP 服务器 URL："

msgctxt "@label:textbox"
msgid "API Token (optional):"
msgstr "API 令牌（可选）："

msgctxt "@info:placeholder"
msgid "Enter API token if required"
msgstr "如有需要请输入 API 令牌"

